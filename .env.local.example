# Copy this file to .env.local and fill in your values
# Never commit .env.local to git

# ── Supabase ────────────────────────────────────────────────────
# From: Supabase Dashboard → Settings → API Keys
# Project URL (same for all key types)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# --- NEW keys (recommended, Supabase 2025+) ---
# Settings → API Keys → "API Keys" tab → Publishable key (starts with sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Settings → API Keys → "API Keys" tab → Secret key (starts with sb_secret_) — server-side only!
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# --- LEGACY keys (still work until end of 2026) ---
# Settings → API Keys → "Legacy API Keys" tab → anon key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Settings → API Keys → "Legacy API Keys" tab → service_role key — server-side only!
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Resend (email) ──────────────────────────────────────────────
# From: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=querydesk@mg.fast-nuces.edu.pk  # or your verified domain

# ── FastAPI backend ─────────────────────────────────────────────
# Local dev: http://localhost:8000
# Production: https://your-service.railway.app  (or Render URL)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── App ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000          # change to prod URL on Vercel
NEXT_PUBLIC_APP_NAME=QueryDesk
NEXT_PUBLIC_INSTITUTION=FAST-NUCES

# ── Supabase Auth (Google OAuth) ────────────────────────────────
# Set these in: Supabase Dashboard → Authentication → Providers → Google
# Google Cloud Console → OAuth 2.0 → Authorised redirect URIs:
#   https://your-project.supabase.co/auth/v1/callback
# No env vars needed here — configured in Supabase dashboard
